# beta-0.2: separate local-only HTTPS read-only WebAdmin gateway.
# Example ONLY. Do not make this virtual host public. There is no MFA and
# therefore no supported public access mode in beta-0.2.
# Required modules: ssl, headers, alias, proxy, proxy_http, authz_core,
# authz_host. Configure a trusted local certificate before use.
# Match DC24H_REMOTE_ORIGIN=https://localhost:8443 in the gateway service.
Listen 127.0.0.1:8443
ProxyRequests Off
ProxyPreserveHost Off
ProxyAddHeaders Off
TraceEnable Off

<VirtualHost 127.0.0.1:8443>
    ServerName localhost
    # Preserve suspicious doubled slashes for the exact ProxyPassMatch route check.
    # Apache otherwise collapses them before matching (MergeSlashes defaults On).
    MergeSlashes Off
    DocumentRoot "/usr/local/share/dc24h/webadmin"
    ServerSignature Off
    SSLEngine On
    SSLCertificateFile "/etc/dc24h/remote-tls/fullchain.pem"
    SSLCertificateKeyFile "/etc/dc24h/remote-tls/privkey.pem"
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCompression Off
    SSLSessionTickets Off
    ProxyTimeout 5
    LimitRequestBody 2048

    <Directory "/usr/local/share/dc24h/webadmin">
        Options -Indexes -Includes -ExecCGI -FollowSymLinks
        AllowOverride None
        Require local
        DirectoryIndex remote.html
    </Directory>
    # Strip browser-supplied process credentials and proxy identity.
    # The gateway injects its own local C++ API token, never the browser.
    RequestHeader unset Authorization
    RequestHeader unset Proxy-Authorization
    RequestHeader unset X-DC24H-Admin-Grant
    RequestHeader unset X-DC24H-Session
    RequestHeader unset X-DC24H-Csrf
    RequestHeader unset Forwarded
    RequestHeader unset Proxy
    RequestHeader unset X-Forwarded-For
    RequestHeader unset X-Forwarded-Host
    RequestHeader unset X-Forwarded-Proto
    RequestHeader unset X-Forwarded-Port
    RequestHeader unset X-Forwarded-Prefix
    RequestHeader unset X-Forwarded-User
    RequestHeader unset X-Real-IP
    RequestHeader unset X-Original-URL
    RequestHeader unset X-Rewrite-URL

    # Exact read-only gateway routes. Never proxy /admin-api, /api, /management
    # or any wildcard into the existing local WebAdmin adapter.
    ProxyPassMatch "^(/remote/v1/(?:challenge|login|session|summary|logout))$" "http://127.0.0.1:4182$1"
    ProxyPassReverse "/remote/v1/" "http://127.0.0.1:4182/remote/v1/"
    <LocationMatch "^/remote/v1/">
        Require local
        Header always set Cache-Control "no-store"
    </LocationMatch>
    <LocationMatch "^/(?:admin-api|api|management)(?:/|$)">
        Require all denied
    </LocationMatch>
    <LocationMatch "(?:^|/)\.">
        Require all denied
    </LocationMatch>
    <FilesMatch "(?i)(^\.|\.(?:token|password|key|pem|p12|pfx|ini|conf|sql|log)(?:\.|$))">
        Require all denied
    </FilesMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cache-Control "no-store"
</VirtualHost>
