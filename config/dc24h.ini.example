# dc24h.eu alpha-0.6.4 configuration (UTF-8, no secrets committed)
# Section names and keys are case-sensitive; duplicate singular keys are errors.
[general]
language = us

[network]
listen = 127.0.0.1:1511
# To enable TLS, uncomment adcs_listen and both certificate/key paths below.
# For TLS only, replace listen above with: listen = none
# adcs_listen = 127.0.0.1:1512
max_connections = 1024
idle_timeout = 120

[users]
# Positive ceilings, shared by ADC/ADCS; effective limits also obey max_connections.
# All sessions count, including anonymous TLS and closing sessions until cleanup.
max_sessions = 65535
# Identified/welcome-pending, ready and closing users count until cleanup.
max_users = 65535

[chat]
# Decoded UTF-8 text bytes; the complete encoded ADC frame is still bounded.
max_text_bytes = 16384
public_enabled = on
private_enabled = on
actions_enabled = on
welcome_enabled = on
# Literal single-line INI text, UTF-8/NFC, at most 4096 bytes; no escape expansion.
welcome_message = Welcome to dc24h.eu. Guest access is enabled.
# Per connection lifetime, shared by public/private messages and ME actions.
# Burst credits refill continuously; bytes count decoded message text, not fanout.
max_messages_per_second = 5
message_burst = 10
max_bytes_per_second = 32768
byte_burst = 131072

[search]
# Global switches override trusted per-session grants. Guests have these defaults.
queries_enabled = on
results_enabled = on
guest_queries = on
guest_results = on
# off preserves passive ncdc/tokenless SCH compatibility; on rejects tokenless DRES.
require_result_token = off
max_active_searches = 4096
max_active_per_user = 8
search_lifetime_seconds = 60
# Per connection: separate request, sent-result and received-result buckets.
# Byte costs include decoded headers, selectors, fields and separators (not fanout).
query_rate = 10
query_burst = 32
query_byte_rate = 32768
query_byte_burst = 131072
result_rate = 64
result_burst = 128
result_byte_rate = 262144
result_byte_burst = 1048576

[security]
max_connections_per_ip = 128
max_accepts_per_minute = 256
max_frames_per_second = 1024
max_invalid_frames = 512
max_pending_logins = 256
max_pending_per_ip = 64
max_login_bytes = 65536
max_login_frames = 64
max_identity_checks_per_minute = 64
max_identity_checks_per_second = 128
tls_handshake_timeout = 10
partial_frame_timeout = 10
login_timeout = 30
output_timeout = 10
close_timeout = 2

[tls]
# certificate = /etc/dc24h/tls/fullchain.pem
# private_key = /etc/dc24h/tls/privkey.pem

[logging]
level = info
# Levels: info, warning, error, off. Per-client lifecycle records are opt-in.
connections = off
# Aggregate outcomes only; no chat text or user IDs. Independent 32 events/s cap.
chat = off
file = stderr
# file = /var/log/dc24h/hub.log

[database]
# Optional; no connection or automatic migration when disabled.
enabled = off
socket = /run/mysqld/mysqld.sock
name = dc24h
user = dc24h
timeout = 5
# Password: private regular file, current effective UID, mode 0600 or 0400.
# password_file = /etc/dc24h/database.password
# alpha-0.1.8 supports local Unix sockets only; TCP database transport is deferred.

[api]
# Local read-only HTTP API. No TCP listener; disabled by default.
enabled = off
max_connections = 16
request_timeout = 2
# Requires an existing private directory (0700), owned by the process UID.
# socket = /run/dc24h/admin.sock
# token_file = /etc/dc24h/admin.token
# Token: openssl rand -hex 32; private file with mode 0600 or 0400.
