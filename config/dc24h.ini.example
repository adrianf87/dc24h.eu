# dc24h.eu alpha-0.1.8 configuration (UTF-8, no secrets committed)
# Section names and keys are case-sensitive; duplicate singular keys are errors.
[general]
language = us

[network]
listen = 127.0.0.1:1511
# To enable TLS, uncomment adcs_listen and both certificate/key paths below.
# For TLS only, replace listen above with: listen = none
# adcs_listen = 127.0.0.1:1512
max_connections = 1024
idle_timeout = 120

[security]
max_connections_per_ip = 128
max_accepts_per_minute = 256
max_frames_per_second = 1024
max_invalid_frames = 512
tls_handshake_timeout = 10
partial_frame_timeout = 10

[tls]
# certificate = /etc/dc24h/tls/fullchain.pem
# private_key = /etc/dc24h/tls/privkey.pem

[logging]
level = info
# Levels: info, warning, error, off. Per-client lifecycle records are opt-in.
connections = off
file = stderr
# file = /var/log/dc24h/hub.log

[database]
# Optional; no connection or automatic migration when disabled.
enabled = off
socket = /run/mysqld/mysqld.sock
name = dc24h
user = dc24h
timeout = 5
# Password: private regular file, current effective UID, mode 0600 or 0400.
# password_file = /etc/dc24h/database.password
# alpha-0.1.8 supports local Unix sockets only; TCP database transport is deferred.
