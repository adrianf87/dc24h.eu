[Unit]
Description=Stage IV C++ authoritative account service (private Unix API)
After=mariadb.service
Requires=mariadb.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=dc24h-stage3
Group=dc24h-stage3
WorkingDirectory=/opt/dc24h
RuntimeDirectory=dc24h-stage4-auth
RuntimeDirectoryMode=0700
StateDirectory=dc24h-stage4-auth
StateDirectoryMode=0700
ExecStart=/opt/dc24h/bin/dc24h-twilight-account-admin --config /var/lib/dc24h-stage4-auth/auth.ini --stage4-serving
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
