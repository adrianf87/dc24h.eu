# dc24h.eu-twilight: static local preview only, no authenticated gateway.
# Keep the local preview host and installed asset paths unchanged in this stage.
# Enable mod_headers. Never proxy the private API or expose its token to JavaScript.
Listen 127.0.0.1:8080
<VirtualHost 127.0.0.1:8080>
    ServerName dc24h-webadmin.local
    DocumentRoot /usr/local/share/dc24h/webadmin
    <Directory /usr/local/share/dc24h/webadmin>
        Options -Indexes -FollowSymLinks
        AllowOverride None
        Require local
        DirectoryIndex index.html
    </Directory>
    <LocationMatch "^/admin-api(?:/|$)">
        Require all denied
    </LocationMatch>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</VirtualHost>
