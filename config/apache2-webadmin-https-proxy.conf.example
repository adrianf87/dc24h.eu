# dc24h.eu beta-0.1.4 — HTTPS reverse proxy for the loopback WebAdmin adapter.
# Debian/Ubuntu: ports.conf owns Listen 80/443; do not duplicate those here.
# Modules: ssl, headers, alias, dir, mime, authz_core, authz_host, proxy, proxy_http.
# Replace the domain, asset path, certificate paths and loopback adapter port before enabling this file.
# The upstream is the loopback HTTP adapter. It is not the C++ Unix socket.
# Do not put a service token or an admin grant in this file.
# Local access remains the default. This is not a public authenticated gateway.

ProxyRequests Off
ProxyPreserveHost Off
ProxyAddHeaders Off
ProxyTimeout 15
TraceEnable Off

<VirtualHost *:80>
    ServerName dc24h.eu
    # A fixed destination prevents redirects based on an untrusted Host header.
    # This virtual host does not proxy. API requests are redirected to HTTPS.
    Redirect permanent / https://dc24h.eu/
</VirtualHost>

<VirtualHost *:443>
    ServerName dc24h.eu
    DocumentRoot "/usr/local/share/dc24h/webadmin"
    ServerSignature Off

    SSLEngine on
    SSLCertificateFile "/etc/dc24h/webadmin-tls/fullchain.pem"
    SSLCertificateKeyFile "/etc/dc24h/webadmin-tls/privkey.pem"
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCipherSuite SSL ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305
    SSLCipherSuite TLSv1.3 TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
    SSLHonorCipherOrder on
    SSLCompression off
    SSLSessionTickets off

    <Directory "/usr/local/share/dc24h/webadmin">
        Options -Indexes -FollowSymLinks -Includes -ExecCGI
        AllowOverride None
        Require local
        DirectoryIndex index.html
    </Directory>

    # Client credentials and forwarded identity never reach the adapter.
    # The adapter injects the service token itself. This file has no token.
    RequestHeader unset Authorization
    RequestHeader unset Cookie
    RequestHeader unset Proxy
    RequestHeader unset Forwarded
    RequestHeader unset X-Forwarded-For
    RequestHeader unset X-Forwarded-Host
    RequestHeader unset X-Forwarded-Proto
    RequestHeader unset X-Forwarded-Server
    RequestHeader unset X-Real-IP
    RequestHeader unset X-DC24H-Admin "expr=%{HTTP:X-DC24H-Admin} != '1'"
    RequestHeader unset X-DC24H-Admin-Grant "expr=%{HTTP:X-DC24H-Admin-Grant} !~ m#^[0-9a-fA-F]{64}$#"
    RequestHeader unset X-DC24H-Session "expr=%{HTTP:X-DC24H-Session} !~ m#^[0-9a-f]{32}$#"
    RequestHeader unset X-DC24H-Csrf "expr=%{HTTP:X-DC24H-Csrf} !~ m#^[0-9a-fA-F]{64}$#"
    # The adapter accepts only an origin equal to its loopback Host.
    RequestHeader set Origin "http://127.0.0.1:4173" "expr=%{HTTP:Origin} == 'https://dc24h.eu'"

    # Path allowlist. Method, host, origin, body and local-client checks are below.
    # ProxyPassMatch cannot distinguish GET from POST, so authorization runs first.
    ProxyPassMatch "^(/admin-api/v1/(?:admin/access|audit|status|health|users|admin|management(?:/authorize|/configuration(?:/(?:write|restore))?)?|accounts(?:/[1-9][0-9]{0,18}(?:/(?:activate|disable|reset|password|role))?)?|bans(?:/[1-9][0-9]{0,18}/revoke)?))$" "http://127.0.0.1:4173$1"
    ProxyPassReverse /admin-api/ "http://127.0.0.1:4173/admin-api/"

    <LocationMatch "^/(?:admin-api|api)(?:/|$)">
        LimitRequestBody 7000
        Header set Cache-Control "no-store"
        Header always set Cache-Control "no-store"
        # GET: status, health, users, admin, management, configuration review, accounts, accounts/{id}, bans.
        # POST: admin/access, audit, management/authorize, configuration validate/write/restore, accounts, accounts/{id}/{action}, bans, bans/{id}/revoke.
        # POST requires the canonical HTTPS origin, the form type, X-DC24H-Admin: 1 and 1..7000 bytes.
        <If "%{HTTP_HOST} == 'dc24h.eu' && %{HTTP:Transfer-Encoding} == '' && (%{HTTP:Sec-Fetch-Site} == '' || %{HTTP:Sec-Fetch-Site} == 'same-origin' || %{HTTP:Sec-Fetch-Site} == 'none') && ((%{REQUEST_METHOD} == 'GET' && (%{HTTP:Origin} == '' || %{HTTP:Origin} == 'https://dc24h.eu') && (%{HTTP:Content-Length} == '' || %{HTTP:Content-Length} == '0') && (%{REQUEST_URI} =~ m#^/admin-api/v1/(?:status|health|users|admin|management(?:/configuration)?)$# || %{REQUEST_URI} =~ m#^/admin-api/v1/accounts(?:/[1-9][0-9]{0,18})?$# || %{REQUEST_URI} =~ m#^/admin-api/v1/bans$#)) || (%{REQUEST_METHOD} == 'POST' && %{HTTP:Origin} == 'https://dc24h.eu' && %{HTTP:Content-Type} == 'application/x-www-form-urlencoded' && %{HTTP:X-DC24H-Admin} == '1' && %{HTTP:Content-Length} =~ m#^[1-9][0-9]{0,3}$# && %{HTTP:Content-Length} -le 7000 && %{REQUEST_URI} =~ m#^/admin-api/v1/(?:admin/access|audit|management/(?:authorize|configuration(?:/(?:write|restore))?)|accounts(?:/[1-9][0-9]{0,18}/(?:activate|disable|reset|password|role))?|bans(?:/[1-9][0-9]{0,18}/revoke)?)$#))">
            Require local
        </If>
        <Else>
            Require all denied
        </Else>
    </LocationMatch>

    <LocationMatch "(?:^|/)\.">
        Require all denied
    </LocationMatch>
    <FilesMatch "(?i)(^\.|\.(?:token|password|key|pem|p12|pfx|ini|conf|sql|log)(?:\.|$))">
        Require all denied
    </FilesMatch>

    # Short, host-only HSTS example. No includeSubDomains or preload commitment.
    Header always set Strict-Transport-Security "max-age=300"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
</VirtualHost>
