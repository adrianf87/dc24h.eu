# Literal KEY=value. Use root:root mode 0600 under /etc/dc24h mode 0700.
# Select test or production and explicitly approve the matching database below.
STAGE4_ENVIRONMENT=test
MARIADB_APPROVED_DATABASE=dc24h_stage4_test

ADMIN_USERNAME=Administrator
ADMIN_EMAIL=admin@dc24h.eu
ADMIN_INITIAL_PASSWORD=
ADMIN_ROLE=owner
ADMIN_REQUIRE_EMAIL_OTP=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=admin@dc24h.eu
SMTP_AUTH=true
SMTP_TLS=true
SMTP_STARTTLS=true
SMTP_VERIFY_CERTIFICATE=true

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_SOCKET=/run/mysqld/mysqld.sock
MARIADB_ROOT_USERNAME=root
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=dc24h_stage4_test
MARIADB_APP_USERNAME=dc24h_stage4
MARIADB_APP_PASSWORD=

WEBADMIN_HOST=server-747585786.dc24h.eu
WEBADMIN_PUBLIC_PORT=7278
WEBADMIN_INTERNAL_HOST=127.0.0.1
WEBADMIN_INTERNAL_PORT=4278
WEBADMIN_HTTPS=true
WEBADMIN_REQUIRE_PASSWORD=true
WEBADMIN_REQUIRE_EMAIL_OTP=true
WEBADMIN_REGISTRATION_EMAIL_VERIFICATION=true
