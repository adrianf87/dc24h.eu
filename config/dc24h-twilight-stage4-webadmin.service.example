# NOT INSTALLED OR ENABLED. Stage IV OWNER qualification template only.
# Requires a separately approved /etc/dc24h/stage4-activation.env, verified
# private account catalog, a working authenticated msmtp configuration and
# exact same-UID access to the private serving C++ API Unix socket/token.
# This sample uses the hub UID due to the current strict same-UID socket gate;
# review the shared security boundary before enabling on a public host.
[Unit]
Description=dc24h.eu public WebAdmin email-code gateway (loopback only)
After=network-online.target dc24h-twilight.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=dc24h
Group=dc24h
WorkingDirectory=/opt/dc24h/webadmin
Environment=DC24H_API_SOCKET=/run/dc24h/api.sock
Environment=DC24H_API_TOKEN_FILE=/run/dc24h/api.token
Environment=DC24H_STAGE4_ORIGIN=https://server-747585786.dc24h.eu:7278
StateDirectory=dc24h-stage4
StateDirectoryMode=0700
Environment=DC24H_STAGE4_VERIFIED_EMAIL_FILE=/var/lib/dc24h-stage4/verified-emails.json
Environment=DC24H_STAGE4_AUDIT_FILE=/var/lib/dc24h-stage4/stage4-audit.jsonl
Environment=DC24H_STAGE4_RATE_LIMIT_FILE=/var/lib/dc24h-stage4/stage4-limits.json
# Mandatory separate OWNER activation file; never commit it or precreate it.
EnvironmentFile=/etc/dc24h/stage4-activation.env
# Must be a service-accessible Node >=22.12 runtime, not /root/.nvm.
ExecStart=/usr/bin/node /opt/dc24h/webadmin/dist/public-main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
TasksMax=96
LimitNOFILE=4096
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
# Do not use PrivateNetwork / IPAddressDeny=any: the gateway needs outbound
# authenticated SMTP to the provider as well as Apache loopback ingress.

[Install]
WantedBy=multi-user.target
