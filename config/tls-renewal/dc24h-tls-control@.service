[Unit]
Description=Handle a private dc24h TLS renewal request

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I /usr/local/libexec/dc24h-tls/tls_renewal.py control
StandardInput=socket
StandardOutput=null
StandardError=journal
RuntimeMaxSec=25
StateDirectory=dc24h-tls
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
