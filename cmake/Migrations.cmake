# Explicit files are individual prepared statements: never split SQL on ';'.
function(dc24h_generate_migrations source_dir output)
    set(manifest "${source_dir}/manifest.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    file(READ "${manifest}" json)
    string(JSON count LENGTH "${json}" migrations)
    if(count LESS 2 OR count GREATER 128)
        message(FATAL_ERROR "Migration catalog must contain 2..128 ordered entries")
    endif()
    set(header "#pragma once\n#include <array>\n#include \"migrations_internal.hpp\"\nnamespace dc24h::database::detail {\n")
    set(entries "")
    set(files "${manifest}")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        math(EXPR expected "${index} + 1")
        string(JSON version GET "${json}" migrations ${index} version)
        string(JSON version_type TYPE "${json}" migrations ${index} version)
        string(JSON name GET "${json}" migrations ${index} name)
        string(JSON steps LENGTH "${json}" migrations ${index} files)
        string(LENGTH "${name}" name_bytes)
        if(NOT version_type STREQUAL "NUMBER" OR NOT version STREQUAL "${expected}" OR NOT name MATCHES "^[a-z][a-z0-9_]*$" OR name_bytes GREATER 128 OR steps LESS 1 OR steps GREATER 32)
            message(FATAL_ERROR "Invalid migration identity/order/step count")
        endif()
        if((version EQUAL 1 AND NOT name STREQUAL "schema_migrations") OR (version EQUAL 2 AND NOT name STREQUAL "migration_state") OR (version LESS 3 AND NOT steps EQUAL 1))
            message(FATAL_ERROR "Invalid immutable bootstrap identity")
        endif()
        if(version LESS 10)
            set(prefix "000${version}")
        elseif(version LESS 100)
            set(prefix "00${version}")
        else()
            set(prefix "0${version}")
        endif()
        set(statements "")
        set(checksum_input "")
        set(seen "")
        math(EXPR step_last "${steps} - 1")
        foreach(step RANGE 0 ${step_last})
            string(JSON filename GET "${json}" migrations ${index} files ${step})
            if(NOT filename MATCHES "^${prefix}_${name}(_[0-9][0-9])?\\.sql$" OR filename IN_LIST seen)
                message(FATAL_ERROR "Invalid migration SQL filename")
            endif()
            list(APPEND seen "${filename}")
            set(path "${source_dir}/${filename}")
            if(IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}")
                message(FATAL_ERROR "Migration SQL must be a regular source file")
            endif()
            file(SIZE "${path}" source_bytes)
            if(source_bytes LESS 1 OR source_bytes GREATER 65536)
                message(FATAL_ERROR "Invalid migration SQL size")
            endif()
            file(READ "${path}" sql_hex HEX)
            string(REGEX REPLACE "(..)" "\\1;" octets "${sql_hex}")
            # Compilers normalize CRLF inside raw literals. Require LF sources
            # so embedded SQL and the exact source checksum cannot diverge.
            if("00" IN_LIST octets OR "0d" IN_LIST octets)
                message(FATAL_ERROR "Migration SQL requires LF text without NUL")
            endif()
            file(READ "${path}" sql)
            string(LENGTH "${sql}" bytes)
            string(FIND "${sql}" ")DC24H_MIG\"" collision)
            if(bytes LESS 1 OR bytes GREATER 65536 OR NOT collision EQUAL -1)
                message(FATAL_ERROR "Invalid migration SQL size/delimiter")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
            list(APPEND files "${path}")
            string(APPEND statements "R\"DC24H_MIG(${sql})DC24H_MIG\",\n")
            if(steps EQUAL 1)
                set(checksum_input "${sql}")
            else()
                string(APPEND checksum_input "${bytes}:${sql}")
            endif()
        endforeach()
        string(SHA256 checksum "${checksum_input}")
        string(APPEND header "inline constexpr std::array<std::string_view, ${steps}> sql_${version}{{${statements}}};\n")
        string(APPEND entries "Entry{{${version}, \"${name}\", \"${checksum}\"}, sql_${version}},\n")
    endforeach()
    string(APPEND header "inline constexpr std::array<Entry, ${count}> builtin_migrations{{${entries}}};\n}\n")
    get_filename_component(parent "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    # SQL may contain literal @name@ or $<...>. Do not template/evaluate it.
    file(WRITE "${output}.tmp" "${header}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}"
        COMMAND_ERROR_IS_FATAL ANY)
    file(REMOVE "${output}.tmp")
    file(GLOB sql_files "${source_dir}/*.sql")
    foreach(path IN LISTS sql_files)
        if(NOT path IN_LIST files)
            message(FATAL_ERROR "Unlisted SQL migration source")
        endif()
    endforeach()
    set(DC24H_MIGRATION_FILES "${files}" PARENT_SCOPE)
endfunction()
